CREATE TABLE EQUIPAMENTOS(
    id NUMBER GENERATED BY DEFAULT AS IDENTITY,
    nome VARCHAR2(255) not null UNIQUE,
    tipo_id NUMBER not null,
    CONSTRAINT pk_equipamentos PRIMARY KEY(id),
    CONSTRAINT fk_tipo FOREIGN KEY (tipo_id) REFERENCES tipos(id),
    CONSTRAINT uk_equipamentos_nome UNIQUE (nome)
);


CREATE TABLE TIPOS (
    id NUMBER GENERATED BY DEFAULT AS IDENTITY,
    nome VARCHAR2(120) NOT NULL,

    CONSTRAINT pk_tipos PRIMARY KEY (id)
);


CREATE TABLE USERS (
    id NUMBER GENERATED BY DEFAULT AS IDENTITY,
    login VARCHAR2(100) NOT NULL UNIQUE,
    password varchar(130) NOT NULL,
    role VARCHAR(10) NOT NULL,
);